// ---- §17.11/12 Payroll groups, periods, salary slips, loan installments ----
model PayrollGroup {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  companyId       String?   @db.Uuid
  name            String
  description     String?
