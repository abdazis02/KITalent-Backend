# ============================================================
# KITalent — Environment Example
# Copy to .env and fill values. Never commit the real .env.
# ============================================================

NODE_ENV=development

# ---- API ----
API_PORT=4000
API_GLOBAL_PREFIX=api
API_CORS_ORIGINS=http://localhost:3000

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://kitalent:kitalent@localhost:5432/kitalent?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT / Auth ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=900            # seconds (15m)
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=1209600       # seconds (14d)
BCRYPT_SALT_ROUNDS=12

# ---- MinIO (object storage) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=kitalent
MINIO_SECRET_KEY=kitalent-secret
MINIO_BUCKET=kitalent

# ---- Localization / Theme defaults ----
DEFAULT_LOCALE=id-ID
SUPPORTED_LOCALES=id-ID,en-US
DEFAULT_THEME=system

# ---- Mail (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="KITalent <no-reply@kitalent.app>"

# ---- Firebase Cloud Messaging (push) ----
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_DEFAULT_LOCALE=id-ID
NEXT_PUBLIC_DEFAULT_THEME=system
